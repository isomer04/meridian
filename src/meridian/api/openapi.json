        "type": "object",
        "required": [
          "artifact_digest",
          "decision",
          "approver"
        ],
        "title": "ApprovalDecisionBody",
        "description": "`loan_id` and `gate` are path parameters; the body carries only the decision\ninputs plus the artifact digest the browser must echo back unchanged."
      },
