# Any one provider key enables `--judgment crew`. Without a key, the stub judgment runs.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides. MERIDIAN_MODEL wins over MODEL.
MERIDIAN_MODEL=
MODEL_FAST=
MODEL_STRONG=

# Optional: override the guideline corpus directory.
MERIDIAN_GUIDELINES=
